APP_ENV=local
AUTH_OPERATOR_RECOVERY_ENABLED=true
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=runa
DB_USERNAME=runa
DB_PASSWORD=
DB_SSLMODE=prefer
LOG_LEVEL=info
KNOWLEDGE_ENABLED=true
QUEUE_CONNECTION=database
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=runa@example.com
MAIL_REQUIRE_TLS=false
# Independent optional module development fixture tuning; no credentials in templates.
# Opt in to module fixtures on default development db:seed / migrate:fresh --seed.
DEV_SEED_MODULES=false
# Optional private initial administrator credentials; set only in .env.dev.local.
DEV_SEED_ADMIN_EMAIL=
DEV_SEED_ADMIN_PASSWORD=
DEV_SEED_AUTH_USERS_COUNT=3
DEV_SEED_AUTH_RANDOM=false
DEV_SEED_AUTH_SEED=17
DEV_SEED_PERMISSIONS_ROLES_COUNT=2
DEV_SEED_PERMISSIONS_RANDOM=false
DEV_SEED_PERMISSIONS_SEED=17
