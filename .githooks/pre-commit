#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
if [ ! -e .git/runa-bootstrap.json ] && [ ! -L .git/runa-bootstrap.json ] && [ -f docs/runa/maintainer/agent-contract.md ] && [ -f tools/maintainer/hook ]; then
    exec python3 tools/maintainer/hook pre-commit "$@"
fi
exec ./tools/application/bin/pre-commit "$@"
