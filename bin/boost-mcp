#!/usr/bin/env python3
"""Exec the fixed Boost stdio adapter from its tool checkout."""

import os
import sys
from pathlib import Path

if __name__ == "__main__":
    root = Path(__file__).resolve().parents[1]
    os.chdir(root)
    os.execvpe(
        sys.executable,
        [sys.executable, "-m", "tools.application.boost_cli", *sys.argv[1:]],
        dict(os.environ, PYTHONPYCACHEPREFIX=str(root / ".runtime/python/pycache")),
    )
