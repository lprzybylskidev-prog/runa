#!/usr/bin/env python3
"""Run pinned project tools inside the development container."""
import fcntl
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
os.chdir(ROOT)
name = Path(sys.argv[0]).name
args = sys.argv[1:]
if '--help' in args:
    print({
        'format': 'Usage: ./bin/format [--check]\nFormat project PHP and frontend/config sources.',
        'lint': 'Usage: ./bin/lint\nCheck JavaScript, TypeScript and Vue without warnings.',
        'typecheck': 'Usage: ./bin/typecheck\nCheck strict application and test TypeScript.',
        'analyse': 'Usage: ./bin/analyse\nRun Larastan/PHPStan at the highest level.',
        'test': 'Usage: ./bin/test [--parallel | frontend | e2e [--critical]] [runner options]\nBackend is the default. E2E starts an isolated loopback fixture harness and uses testing Nginx/PHP-FPM.',
    }[name])
    sys.exit(0)

def run(command, **kwargs):
    subprocess.run(command, check=True, cwd=ROOT / 'src', **kwargs)

try:
    if not Path('/.dockerenv').exists():
        command = ['docker', 'compose', '--env-file', '.env.dev.local', '-f', 'compose.yaml', '-f', '.devcontainer/compose.resources.yaml']
        if name == 'test' and args and args[0] == 'e2e':
            subprocess.run(command + ['--profile', 'testing', 'up', '-d', '--wait', 'nginx-test'], check=True)
        subprocess.run(command + ['exec', '-T', 'app', './bin/' + name, *args], check=True)
    elif name == 'format':
        if args not in ([], ['--check']):
            raise ValueError('Only --check is supported.')
        run(['vendor/bin/pint', *(['--test'] if args else [])])
        run(['pnpm', 'exec', 'prettier', '--check' if args else '--write', 'app/resources', 'runa/resources', 'runa/tests/frontend', 'runa/tests/e2e', '*.mjs', 'package.json', 'tsconfig.json', 'pint.json', '../.prettierrc.json'])
    elif name == 'lint':
        run(['pnpm', 'exec', 'eslint', 'app/resources', 'runa/resources', 'runa/tests/frontend', 'runa/tests/e2e', '*.mjs', '--max-warnings=0', *args])
    elif name == 'typecheck':
        run(['pnpm', 'run', 'typecheck', *args])
    elif name == 'analyse':
        run(['vendor/bin/phpstan', 'analyse', '--memory-limit=1G', *args])
    elif name == 'test':
        (ROOT / '.runtime/tests').mkdir(parents=True, exist_ok=True)
        # Independent processes must not mutate the same worker databases or E2E endpoint.
        with (ROOT / '.runtime/tests/suite.lock').open('w') as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise ValueError('Another test suite is running in this checkout.')
            if args and args[0] == 'frontend':
                run(['pnpm', 'exec', 'vitest', 'run', *args[1:]])
            elif args and args[0] == 'e2e':
                # The frontend build replaces error output; finalize its current shells before the harness reads them.
                run(['php', 'runa/resources/errors/build.php'])
                run(['pnpm', 'exec', 'playwright', 'test', *[arg for arg in args[1:] if arg != '--critical']])
            else:
                if (ROOT / 'src/bootstrap/cache/config.php').exists():
                    raise ValueError('Clear cached development config before testing: php artisan config:clear')
                env = dict(os.environ, APP_ENV='testing')
                if '--parallel' in args and not any(arg.startswith('--processes') for arg in args):
                    args += ['--processes=' + os.environ.get('TEST_WORKERS', '4')]
                run(['vendor/bin/pest', *args], env=env)
except (ValueError, subprocess.CalledProcessError) as error:
    print(str(error), file=sys.stderr)
    sys.exit(getattr(error, 'returncode', 1))
