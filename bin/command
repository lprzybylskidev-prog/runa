#!/usr/bin/env python3
"""Thin recovery aliases for single-purpose Artisan source commands."""
from pathlib import Path
import subprocess
import sys
ROOT = Path(__file__).resolve().parents[1]
name = Path(sys.argv[0]).name
if name not in ('format', 'lint', 'typecheck', 'analyse', 'test', 'deploy'):
    raise SystemExit(subprocess.run([str(ROOT / 'bin/artisan'), '--management', 'list'], cwd=ROOT).returncode)
raise SystemExit(subprocess.run([str(ROOT / 'bin/artisan'), '--management', 'runa:' + name, *sys.argv[1:]], cwd=ROOT).returncode)
