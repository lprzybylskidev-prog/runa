#!/usr/bin/env python3
"""Host-side development lifecycle and resource profiles."""
import json
import hashlib
import os
from pathlib import Path
import re
import secrets
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
LOCAL = ROOT / '.env.dev.local'
OVERRIDE = ROOT / '.devcontainer/compose.resources.yaml'
PRESETS = {
    'low': ('2', '2G', '2', '1'),
    'standard': ('4', '4G', '4', '2'),
    'high': ('20', '16G', '12', '4'),
}
KEYS = ('DEV_CPU_LIMIT', 'DEV_MEMORY_LIMIT', 'TEST_WORKERS', 'PLAYWRIGHT_WORKERS')
ALLOWED = set(KEYS) | {'DEV_PROFILE', 'RUNA_UID', 'RUNA_GID'}


def load():
    values = dict(zip(KEYS, PRESETS['standard']))
    values.update(DEV_PROFILE='standard', RUNA_UID=str(os.getuid()), RUNA_GID=str(os.getgid()))
    if LOCAL.exists():
        for line in LOCAL.read_text().splitlines():
            if not line.strip() or line.lstrip().startswith('#'):
                continue
            key, sep, value = line.partition('=')
            if not sep or key not in ALLOWED:
                raise ValueError(f'Unsupported local profile setting: {key}')
            values[key] = value
    validate(values)
    return values


def validate(values):
    if values['DEV_PROFILE'] not in (*PRESETS, 'custom'):
        raise ValueError('DEV_PROFILE must be low, standard, high or custom.')
    if not re.fullmatch(r'[0-9]+(?:\.[0-9]+)?', values['DEV_CPU_LIMIT']) or float(values['DEV_CPU_LIMIT']) <= 0:
        raise ValueError('DEV_CPU_LIMIT must be a positive number.')
    if not re.fullmatch(r'[1-9][0-9]*(?:M|G)', values['DEV_MEMORY_LIMIT']):
        raise ValueError('DEV_MEMORY_LIMIT must be a positive integer followed by M or G.')
    for key in ('TEST_WORKERS', 'PLAYWRIGHT_WORKERS', 'RUNA_UID', 'RUNA_GID'):
        if not values[key].isdigit() or int(values[key]) < 1:
            raise ValueError(f'{key} must be a positive integer.')


def persist(values):
    validate(values)
    LOCAL.write_text(''.join(f'{key}={values[key]}\n' for key in ('DEV_PROFILE', *KEYS, 'RUNA_UID', 'RUNA_GID')))
    LOCAL.chmod(0o600)
    # VS Code invokes Compose itself, so it needs the same resolved settings.
    service = {'cpus': float(values['DEV_CPU_LIMIT']), 'mem_limit': values['DEV_MEMORY_LIMIT'],
               'build': {'args': {key: values[key] for key in ('RUNA_UID', 'RUNA_GID')}},
               'environment': {key: values[key] for key in ('TEST_WORKERS', 'PLAYWRIGHT_WORKERS')}}
    tier = values['DEV_PROFILE'] if values['DEV_PROFILE'] in PRESETS else 'standard'
    database_memory = {'low': '256M', 'standard': '512M', 'high': '1G'}[tier]
    worker_memory = '256M' if tier == 'low' else '512M'
    siblings = {
        'postgres': {'cpus': {'low': .5, 'standard': 1, 'high': 2}[tier], 'mem_limit': database_memory},
        'queue': {'cpus': 1, 'mem_limit': worker_memory},
        'scheduler': {'cpus': .25, 'mem_limit': '128M'},
        'nginx': {'cpus': .25, 'mem_limit': '64M'},
        'mailpit': {'cpus': .25, 'mem_limit': '128M',
                    'build': {'args': {key: values[key] for key in ('RUNA_UID', 'RUNA_GID')}}},
        'setup': {'cpus': float(values['DEV_CPU_LIMIT']), 'mem_limit': values['DEV_MEMORY_LIMIT']},
    }
    for role in ('setup', 'queue', 'scheduler'):
        siblings[role]['build'] = {'args': {key: values[key] for key in ('RUNA_UID', 'RUNA_GID')}}
    OVERRIDE.write_text(json.dumps({'services': {'app': service, **siblings}}, indent=2) + '\n')


def environment_files():
    template = ROOT / '.env.dev.example'
    if not template.exists():
        return
    env = ROOT / '.env'
    if not env.exists():
        env.write_text(template.read_text().replace('DB_PASSWORD=\n', 'DB_PASSWORD=' + secrets.token_urlsafe(32) + '\n'))
        env.chmod(0o600)
    application = dict(line.split('=', 1) for line in env.read_text().splitlines() if '=' in line and not line.startswith('#'))
    infrastructure = ROOT / '.env.dev.database'
    if not infrastructure.exists():
        infrastructure.write_text('POSTGRES_PASSWORD=' + secrets.token_urlsafe(32) + '\nAPP_DB_PASSWORD=' + application['DB_PASSWORD'] + '\nTEST_DB_PASSWORD=' + secrets.token_urlsafe(32) + '\n')
        infrastructure.chmod(0o600)
    settings = dict(line.split('=', 1) for line in infrastructure.read_text().splitlines() if '=' in line and not line.startswith('#'))
    if not all(settings.get(key) for key in ('POSTGRES_PASSWORD', 'APP_DB_PASSWORD', 'TEST_DB_PASSWORD')):
        raise ValueError('Development database credentials must be non-empty.')
    if settings['APP_DB_PASSWORD'] != application['DB_PASSWORD']:
        raise ValueError('Application and database initialization credentials differ. Reconcile local files and existing database roles explicitly.')
    testing = ROOT / '.env.testing'
    if not testing.exists():
        testing.write_text((ROOT / '.env.test.example').read_text().replace('DB_PASSWORD=\n', 'DB_PASSWORD=' + settings['TEST_DB_PASSWORD'] + '\n').replace('APP_KEY=\n', 'APP_KEY=' + application.get('APP_KEY', '') + '\n'))
        testing.chmod(0o600)


def setup_fingerprint():
    paths = [ROOT / p for p in ('composer.lock', 'pnpm-lock.yaml', 'vite.config.mjs', 'tsconfig.json', '.env', 'bin/dev')]
    for directory in ('config', 'database/migrations', 'resources'):
        paths.extend(p for p in (ROOT / directory).rglob('*') if p.is_file())
    digest = hashlib.sha256()
    for path in sorted(paths):
        digest.update(str(path.relative_to(ROOT)).encode())
        digest.update(path.read_bytes())
    return digest.hexdigest()


def main():
    args = sys.argv[1:]
    if not args or args[0] in ('--help', '-h'):
        print('Usage: ./bin/dev profile [low|standard|high|custom KEY=VALUE ...]\n'
              '       ./bin/dev prepare|build|up|down|config|shell\n'
              '       ./bin/dev setup [--if-needed] (inside the devcontainer)\n'
              'Run Docker lifecycle commands on the host. Profile changes apply on container recreation.\n'
              'down preserves volumes; destructive volume deletion is not supported.')
        return 0
    values = load()
    command = args.pop(0)
    if command == 'profile':
        if args:
            profile = args.pop(0)
            if profile not in (*PRESETS, 'custom'):
                raise ValueError('Unknown resource profile.')
            values['DEV_PROFILE'] = profile
            if profile != 'custom':
                if args:
                    raise ValueError('Overrides require the custom profile.')
                values.update(zip(KEYS, PRESETS[profile]))
            for setting in args:
                key, sep, value = setting.partition('=')
                if not sep or key not in KEYS:
                    raise ValueError('Custom settings must use the documented resource keys.')
                values[key] = value
            persist(values)
        print('\n'.join(f'{key}={values[key]}' for key in ('DEV_PROFILE', *KEYS)))
        return 0
    if command == 'setup':
        if args not in ([], ['--if-needed']) or not Path('/.dockerenv').exists():
            raise ValueError('Run ./bin/dev setup [--if-needed] inside the devcontainer.')
        environment_files()
        env = ROOT / '.env'
        marker = ROOT / '.runtime/dev/setup.sha256'
        required = ['vendor/autoload.php', 'node_modules/.modules.yaml', 'public/build/index.html']
        if args == ['--if-needed'] and marker.exists() and marker.read_text().strip() == setup_fingerprint() and all((ROOT / p).exists() for p in required):
            subprocess.run(['php', 'artisan', 'runa:config:validate', '--templates'], cwd=ROOT, check=True)
            subprocess.run(['php', 'artisan', 'migrate', '--force'], cwd=ROOT, check=True)
            subprocess.run(['git', 'config', 'core.hooksPath', '.githooks'], cwd=ROOT, check=True)
            print('Development setup is current; dependency installation and frontend build skipped.')
            return 0
        subprocess.run(['composer', 'install', '--no-interaction', '--prefer-dist'], cwd=ROOT, check=True)
        if any(line == 'APP_KEY=' for line in env.read_text().splitlines()):
            subprocess.run(['php', 'artisan', 'key:generate', '--force'], cwd=ROOT, check=True)
        testing = ROOT / '.env.testing'
        if 'APP_KEY=\n' in testing.read_text():
            key = next(line for line in env.read_text().splitlines() if line.startswith('APP_KEY='))
            testing.write_text(testing.read_text().replace('APP_KEY=\n', key + '\n'))
        subprocess.run(['php', 'artisan', 'runa:config:validate', '--templates'], cwd=ROOT, check=True)
        subprocess.run(['php', 'artisan', 'migrate', '--force'], cwd=ROOT, check=True)
        subprocess.run(['pnpm', 'install', '--frozen-lockfile'], cwd=ROOT, check=True)
        subprocess.run(['pnpm', 'run', 'build'], cwd=ROOT, check=True)
        subprocess.run(['git', 'config', 'core.hooksPath', '.githooks'], cwd=ROOT, check=True)
        marker.parent.mkdir(parents=True, exist_ok=True)
        marker.write_text(setup_fingerprint() + '\n')
        return 0
    if args:
        raise ValueError('Unexpected arguments. See ./bin/dev --help.')
    persist(values)
    if command == 'prepare':
        environment_files()
        print('Development profile prepared; persistent data preserved.')
        return 0
    if Path('/.dockerenv').exists():
        raise ValueError('Run Docker lifecycle commands in a host terminal, outside the devcontainer.')
    commands = {'build': ['build', 'app', 'mailpit'], 'up': ['up', '-d', '--wait'],
                'down': ['down'], 'config': ['config'], 'shell': ['exec', 'app', 'bash']}
    if command not in commands:
        raise ValueError('Unknown command. See ./bin/dev --help.')
    result = subprocess.run(['docker', 'compose', '--project-directory', str(ROOT),
                             '--env-file', str(LOCAL), '-f', str(ROOT / 'compose.yaml'),
                             '-f', str(OVERRIDE), *commands[command]], cwd=ROOT, check=False)
    return result.returncode


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print(f'Error: {error}', file=sys.stderr)
        sys.exit(1)
