#!/usr/bin/env python3
"""Host-side development lifecycle and resource profiles."""
import json
import hashlib
import fcntl
import os
from pathlib import Path
import re
import secrets
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
LOCAL = ROOT / '.env.dev.local'
OVERRIDE = ROOT / '.devcontainer/compose.resources.yaml'
PRESETS = {
    'low': ('2', '2G', '2', '1'),
    'standard': ('4', '4G', '4', '2'),
    'high': ('20', '16G', '12', '4'),
}
KEYS = ('DEV_CPU_LIMIT', 'DEV_MEMORY_LIMIT', 'TEST_WORKERS', 'PLAYWRIGHT_WORKERS')
ALLOWED = set(KEYS) | {'DEV_PROFILE', 'RUNA_UID', 'RUNA_GID', 'EMBEDDINGS_DEVICE', 'EMBEDDINGS_CUDA'}


def load():
    values = dict(zip(KEYS, PRESETS['standard']))
    values.update(DEV_PROFILE='standard', RUNA_UID=str(os.getuid()), RUNA_GID=str(os.getgid()), EMBEDDINGS_DEVICE='auto', EMBEDDINGS_CUDA='0')
    if LOCAL.exists():
        for line in LOCAL.read_text().splitlines():
            if not line.strip() or line.lstrip().startswith('#'):
                continue
            key, sep, value = line.partition('=')
            if not sep or key not in ALLOWED:
                raise ValueError(f'Unsupported local profile setting: {key}')
            values[key] = value
    validate(values)
    return values


def validate(values):
    if values['EMBEDDINGS_DEVICE'] not in ('auto', 'cpu', 'cuda') or values['EMBEDDINGS_CUDA'] not in ('0', '1'):
        raise ValueError('Invalid embeddings device settings.')
    if values['DEV_PROFILE'] not in (*PRESETS, 'custom'):
        raise ValueError('DEV_PROFILE must be low, standard, high or custom.')
    if not re.fullmatch(r'[0-9]+(?:\.[0-9]+)?', values['DEV_CPU_LIMIT']) or float(values['DEV_CPU_LIMIT']) <= 0:
        raise ValueError('DEV_CPU_LIMIT must be a positive number.')
    if not re.fullmatch(r'[1-9][0-9]*(?:M|G)', values['DEV_MEMORY_LIMIT']):
        raise ValueError('DEV_MEMORY_LIMIT must be a positive integer followed by M or G.')
    for key in ('TEST_WORKERS', 'PLAYWRIGHT_WORKERS', 'RUNA_UID', 'RUNA_GID'):
        if not values[key].isdigit() or int(values[key]) < 1:
            raise ValueError(f'{key} must be a positive integer.')


def persist(values):
    validate(values)
    LOCAL.write_text(''.join(f'{key}={values[key]}\n' for key in ('DEV_PROFILE', *KEYS, 'RUNA_UID', 'RUNA_GID', 'EMBEDDINGS_DEVICE', 'EMBEDDINGS_CUDA')))
    LOCAL.chmod(0o600)
    # VS Code invokes Compose itself, so it needs the same resolved settings.
    service = {'cpus': float(values['DEV_CPU_LIMIT']), 'mem_limit': values['DEV_MEMORY_LIMIT'],
               'build': {'args': {key: values[key] for key in ('RUNA_UID', 'RUNA_GID')}},
               'environment': {key: values[key] for key in ('TEST_WORKERS', 'PLAYWRIGHT_WORKERS')}}
    tier = values['DEV_PROFILE'] if values['DEV_PROFILE'] in PRESETS else 'standard'
    database_memory = {'low': '256M', 'standard': '512M', 'high': '1G'}[tier]
    worker_memory = '256M' if tier == 'low' else '512M'
    siblings = {
        'postgres': {'cpus': {'low': .5, 'standard': 1, 'high': 2}[tier], 'mem_limit': database_memory},
        'queue': {'cpus': 1, 'mem_limit': worker_memory},
        'scheduler': {'cpus': .25, 'mem_limit': '128M'},
        'nginx': {'cpus': .25, 'mem_limit': '64M'},
        'mailpit': {'cpus': .25, 'mem_limit': '128M',
                    'build': {'args': {key: values[key] for key in ('RUNA_UID', 'RUNA_GID')}}},
        'setup': {'cpus': float(values['DEV_CPU_LIMIT']), 'mem_limit': values['DEV_MEMORY_LIMIT']},
    }
    siblings['knowledge-init'] = {'build': {'args': {key: values[key] for key in ('RUNA_UID', 'RUNA_GID')}}}
    for role in ('setup', 'queue', 'scheduler'):
        siblings[role]['build'] = {'args': {key: values[key] for key in ('RUNA_UID', 'RUNA_GID')}}
    siblings['qdrant'] = {'cpus': {'low': .5, 'standard': 1, 'high': 2}[tier],
                          'mem_limit': {'low': '256M', 'standard': '512M', 'high': '1G'}[tier],
                          'build': {'args': {key: values[key] for key in ('RUNA_UID', 'RUNA_GID')}}}
    siblings['embeddings'] = {'cpus': {'low': 1, 'standard': 2, 'high': 4}[tier], 'mem_limit': '2G',
                             'build': {'args': {key: values[key] for key in ('RUNA_UID', 'RUNA_GID')}}}
    if values['EMBEDDINGS_CUDA'] == '1':
        config = json.loads((ROOT / 'tools/knowledge/config.json').read_text())
        siblings['embeddings-gpu'] = {
            'image': 'runa-embeddings-cuda:dev',
            'build': {'context': '.', 'dockerfile': 'docker/embeddings/cuda.Dockerfile', 'args': {
                'RUNA_UID': values['RUNA_UID'], 'RUNA_GID': values['RUNA_GID']}},
            'command': ['--model-id', config['model_id'], '--revision', config['model_revision'],
                        '--dtype', 'float32', '--auto-truncate', 'false', '--pooling', 'cls', '--port', '8080',
                        '--max-client-batch-size', '16', '--max-batch-tokens', '2048', '--tokenization-workers', '2', '--json-output'],
            'volumes': ['embedding-cache:/data'],
            'deploy': {'resources': {'reservations': {'devices': [{'driver': 'nvidia', 'count': 1, 'capabilities': ['gpu']}]}}},
            'cap_drop': ['ALL'], 'security_opt': ['no-new-privileges:true'],
            'logging': {'driver': 'json-file', 'options': {'max-size': '10m', 'max-file': '3'}},
            'cpus': 2, 'mem_limit': '4G', 'restart': 'unless-stopped',
        }
    OVERRIDE.write_text(json.dumps({'services': {'app': service, **siblings}}, indent=2) + '\n')


def resolve_embeddings(values):
    if Path('/.dockerenv').exists():
        return
    enabled = False
    if values['EMBEDDINGS_DEVICE'] != 'cpu':
        try:
            gpu = subprocess.run(['nvidia-smi', '--query-gpu=compute_cap', '--format=csv,noheader'],
                                 check=True, capture_output=True, text=True)
            runtimes = subprocess.run(['docker', 'info', '--format', '{{json .Runtimes}}'],
                                      check=True, capture_output=True, text=True)
            enabled = 'nvidia' in json.loads(runtimes.stdout) and any(float(line) >= 7.5 for line in gpu.stdout.splitlines())
        except (OSError, ValueError, subprocess.CalledProcessError):
            enabled = False
    if values['EMBEDDINGS_DEVICE'] == 'cuda' and not enabled:
        raise ValueError('CUDA requested but no supported NVIDIA GPU/Docker runtime was found. Use embeddings cpu or fix the host runtime.')
    values['EMBEDDINGS_CUDA'] = '1' if enabled else '0'
    print('Embeddings: CUDA preferred with CPU fallback.' if enabled else 'Embeddings: CPU (CUDA disabled or unavailable).')


def knowledge_availability():
    # A separate process bounds DNS/connect/read and prevents optional probes from
    # inheriting the indexing transport's long retries.
    try:
        result = subprocess.run([sys.executable, str(ROOT / 'tools/knowledge/startup.py'), 'probe'],
                                cwd=ROOT, timeout=5, check=False)
        if result.returncode:
            print('DEGRADED: optional knowledge unavailable; use source search.')
            return
        result = subprocess.run([str(ROOT / 'bin/knowledge'), 'status'], cwd=ROOT,
                                timeout=8, check=False)
        if result.returncode:
            print('DEGRADED: knowledge freshness unavailable/stale; use source search or ./bin/knowledge index.')
    except subprocess.TimeoutExpired:
        print('DEGRADED: optional knowledge probe timed out; use source search.')


def environment_files():
    template = ROOT / '.env.dev.example'
    if not template.exists():
        return
    env = ROOT / '.env'
    if not env.exists():
        env.write_text(template.read_text().replace('DB_PASSWORD=\n', 'DB_PASSWORD=' + secrets.token_urlsafe(32) + '\n'))
        env.chmod(0o600)
    application = dict(line.split('=', 1) for line in env.read_text().splitlines() if '=' in line and not line.startswith('#'))
    infrastructure = ROOT / '.env.dev.database'
    if not infrastructure.exists():
        infrastructure.write_text('POSTGRES_PASSWORD=' + secrets.token_urlsafe(32) + '\nAPP_DB_PASSWORD=' + application['DB_PASSWORD'] + '\nTEST_DB_PASSWORD=' + secrets.token_urlsafe(32) + '\n')
        infrastructure.chmod(0o600)
    settings = dict(line.split('=', 1) for line in infrastructure.read_text().splitlines() if '=' in line and not line.startswith('#'))
    if not all(settings.get(key) for key in ('POSTGRES_PASSWORD', 'APP_DB_PASSWORD', 'TEST_DB_PASSWORD')):
        raise ValueError('Development database credentials must be non-empty.')
    if settings['APP_DB_PASSWORD'] != application['DB_PASSWORD']:
        raise ValueError('Application and database initialization credentials differ. Reconcile local files and existing database roles explicitly.')
    testing = ROOT / '.env.testing'
    if not testing.exists():
        testing.write_text((ROOT / '.env.test.example').read_text().replace('DB_PASSWORD=\n', 'DB_PASSWORD=' + settings['TEST_DB_PASSWORD'] + '\n').replace('APP_KEY=\n', 'APP_KEY=' + application.get('APP_KEY', '') + '\n'))
        testing.chmod(0o600)


def setup_fingerprint():
    paths = [ROOT / p for p in ('composer.lock', 'pnpm-lock.yaml', 'vite.config.mjs', 'tsconfig.json', '.env', 'bin/dev')]
    for directory in ('config', 'database/migrations', 'resources'):
        paths.extend(p for p in (ROOT / directory).rglob('*') if p.is_file())
    digest = hashlib.sha256()
    for path in sorted(paths):
        digest.update(str(path.relative_to(ROOT)).encode())
        digest.update(path.read_bytes())
    return digest.hexdigest()


def register_boost():
    # Register in the container user's configuration before project trust is established.
    subprocess.run(['codex', 'mcp', 'add', 'laravel-boost', '--', str(ROOT / 'bin/boost-mcp')],
                   cwd=ROOT, check=True)


def application_setup(args):
    environment_files()
    subprocess.run(['python3', 'tools/project/install-scanners.py'], cwd=ROOT, check=True)
    env = ROOT / '.env'
    marker = ROOT / '.runtime/dev/setup.sha256'
    required = ['vendor/autoload.php', 'node_modules/.modules.yaml', 'public/build/index.html', 'public/runa-error/styles.css', 'public/runa-error/pages/503-pl.html']
    if args == ['--if-needed'] and marker.exists() and marker.read_text().strip() == setup_fingerprint() and all((ROOT / p).exists() for p in required):
        subprocess.run(['php', 'artisan', 'runa:config:validate', '--templates'], cwd=ROOT, check=True)
        subprocess.run(['php', 'artisan', 'migrate', '--force'], cwd=ROOT, check=True)
        subprocess.run(['git', 'config', 'core.hooksPath', '.githooks'], cwd=ROOT, check=True)
        register_boost()
        print('Development setup is current; dependency installation and frontend build skipped.')
        return 0
    subprocess.run(['composer', 'install', '--no-interaction', '--prefer-dist'], cwd=ROOT, check=True)
    if any(line == 'APP_KEY=' for line in env.read_text().splitlines()):
        subprocess.run(['php', 'artisan', 'key:generate', '--force'], cwd=ROOT, check=True)
    testing = ROOT / '.env.testing'
    if 'APP_KEY=\n' in testing.read_text():
        key = next(line for line in env.read_text().splitlines() if line.startswith('APP_KEY='))
        testing.write_text(testing.read_text().replace('APP_KEY=\n', key + '\n'))
    subprocess.run(['php', 'artisan', 'runa:config:validate', '--templates'], cwd=ROOT, check=True)
    subprocess.run(['php', 'artisan', 'migrate', '--force'], cwd=ROOT, check=True)
    subprocess.run(['pnpm', 'install', '--frozen-lockfile'], cwd=ROOT, check=True)
    subprocess.run(['pnpm', 'run', 'build'], cwd=ROOT, check=True)
    subprocess.run(['php', 'resources/errors/build.php'], cwd=ROOT, check=True)
    subprocess.run(['git', 'config', 'core.hooksPath', '.githooks'], cwd=ROOT, check=True)
    register_boost()
    marker.parent.mkdir(parents=True, exist_ok=True)
    marker.write_text(setup_fingerprint() + '\n')
    return 0


def main():
    args = sys.argv[1:]
    if not args or args[0] in ('--help', '-h'):
        print('Usage: ./bin/dev profile [low|standard|high|custom KEY=VALUE ...]\n'
              '       ./bin/dev prepare|up|down|config|shell|status|doctor\n'
              '       ./bin/dev build [service ...] | recreate service [service ...] (host only)\n'
              '       ./bin/dev restart|logs [service] (host only)\n'
              '       ./bin/dev embeddings auto|cpu|cuda (host only)\n'
              '       ./bin/dev setup [--if-needed] (inside the devcontainer)\n'
              '       ./bin/dev knowledge-init|knowledge-status (inside the devcontainer)\n'
              'Run Docker lifecycle commands on the host. Profile changes apply on container recreation.\n'
              'down preserves volumes; destructive volume deletion is not supported.')
        return 0
    values = load()
    command = args.pop(0)
    if command == 'embeddings':
        if Path('/.dockerenv').exists() or len(args) != 1 or args[0] not in ('auto', 'cpu', 'cuda'):
            raise ValueError('Run ./bin/dev embeddings auto|cpu|cuda on the host.')
        values['EMBEDDINGS_DEVICE'] = args[0]
        resolve_embeddings(values)
        persist(values)
        print('Apply using ./bin/dev build and ./bin/dev up (persistent data preserved).')
        return 0
    if command == 'profile':
        if args:
            profile = args.pop(0)
            if profile not in (*PRESETS, 'custom'):
                raise ValueError('Unknown resource profile.')
            values['DEV_PROFILE'] = profile
            if profile != 'custom':
                if args:
                    raise ValueError('Overrides require the custom profile.')
                values.update(zip(KEYS, PRESETS[profile]))
            for setting in args:
                key, sep, value = setting.partition('=')
                if not sep or key not in KEYS:
                    raise ValueError('Custom settings must use the documented resource keys.')
                values[key] = value
            persist(values)
        print('\n'.join(f'{key}={values[key]}' for key in ('DEV_PROFILE', *KEYS)))
        return 0
    if command in ('knowledge-init', 'knowledge-status'):
        if args or not Path('/.dockerenv').exists():
            raise ValueError('Run knowledge-init/knowledge-status inside the development container.')
        if command == 'knowledge-status':
            knowledge_availability()
            return 0
        return subprocess.run([sys.executable, str(ROOT / 'tools/knowledge/startup.py'), 'initialize'], cwd=ROOT).returncode
    if command == 'setup':
        if args not in ([], ['--if-needed']) or not Path('/.dockerenv').exists():
            raise ValueError('Run ./bin/dev setup [--if-needed] inside the devcontainer.')
        lock_dir = ROOT / '.runtime/dev'
        lock_dir.mkdir(parents=True, exist_ok=True)
        with (lock_dir / 'setup.lock').open('w') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            return application_setup(args)
    if command == 'doctor':
        if args:
            raise ValueError('Usage: ./bin/dev doctor')
        return subprocess.run([str(ROOT / 'bin/doctor'), 'development'], cwd=ROOT).returncode
    if command in ('restart', 'logs', 'status'):
        if Path('/.dockerenv').exists():
            raise ValueError('Run Docker lifecycle commands in a host terminal, outside the devcontainer.')
        services = ('app', 'nginx', 'postgres', 'queue', 'scheduler', 'mailpit', 'qdrant', 'embeddings', 'embeddings-gpu', 'setup', 'knowledge-init')
        if len(args) > 1 or (args and (args[0] not in services or command == 'status')):
            raise ValueError('Provide at most one known service for restart/logs; status takes no arguments.')
        action = {'status': ['ps', '--all'], 'restart': ['restart'], 'logs': ['logs', '--tail', '100']}[command]
        return subprocess.run(['docker', 'compose', '--project-directory', str(ROOT), '--env-file', str(LOCAL),
                               '-f', str(ROOT / 'compose.yaml'), '-f', str(OVERRIDE), *action, *args], cwd=ROOT).returncode
    if command in ('build', 'recreate'):
        if Path('/.dockerenv').exists():
            raise ValueError('Run Docker lifecycle commands in a host terminal, outside the devcontainer.')
        buildable = ('app', 'setup', 'queue', 'scheduler', 'knowledge-init', 'mailpit', 'qdrant', 'embeddings', 'embeddings-gpu')
        known = (*buildable, 'nginx', 'postgres')
        if command == 'recreate' and not args:
            raise ValueError('Recreate requires explicit service names; review dependencies before using --no-deps.')
        if len(args) != len(set(args)) or any(name not in (buildable if command == 'build' else known) for name in args):
            raise ValueError('Provide unique known services; build requires services with a local build definition.')
        if 'embeddings-gpu' in args and values['EMBEDDINGS_CUDA'] != '1':
            raise ValueError('CUDA service is not configured; select supported CUDA hardware first.')
        resolve_embeddings(values)
        persist(values)
        selected = args or ['app', 'mailpit', 'qdrant', 'embeddings', *(['embeddings-gpu'] if values['EMBEDDINGS_CUDA'] == '1' else [])]
        action = ['build'] if command == 'build' else ['up', '-d', '--no-deps', '--force-recreate']
        if command == 'recreate':
            print('Recreating only selected services; prerequisites must already be ready. Check health after recreation.')
        return subprocess.run(['docker', 'compose', '--project-directory', str(ROOT), '--env-file', str(LOCAL),
                               '-f', str(ROOT / 'compose.yaml'), '-f', str(OVERRIDE), *action, *selected], cwd=ROOT).returncode
    if args:
        raise ValueError('Unexpected arguments. See ./bin/dev --help.')
    resolve_embeddings(values)
    persist(values)
    if command == 'prepare':
        environment_files()
        print('Development profile prepared; persistent data preserved.')
        return 0
    if Path('/.dockerenv').exists():
        raise ValueError('Run Docker lifecycle commands in a host terminal, outside the devcontainer.')
    commands = {'up': ['up', '-d', '--wait', 'postgres', 'app', 'setup', 'nginx', 'queue', 'scheduler', 'mailpit'],
                'down': ['down'], 'config': ['config'], 'shell': ['exec', 'app', 'bash']}
    if command not in commands:
        raise ValueError('Unknown command. See ./bin/dev --help.')
    result = subprocess.run(['docker', 'compose', '--project-directory', str(ROOT),
                             '--env-file', str(LOCAL), '-f', str(ROOT / 'compose.yaml'),
                             '-f', str(OVERRIDE), *commands[command]], cwd=ROOT, check=False)
    if command == 'up' and result.returncode == 0:
        context = ['docker', 'compose', '--project-directory', str(ROOT), '--env-file', str(LOCAL),
                   '-f', str(ROOT / 'compose.yaml'), '-f', str(OVERRIDE)]
        optional = ['qdrant', 'embeddings', *(['embeddings-gpu'] if values['EMBEDDINGS_CUDA'] == '1' else []), 'knowledge-init']
        ai = subprocess.run([*context, 'up', '-d', '--no-deps', *optional], cwd=ROOT, check=False)
        if ai.returncode:
            print('DEGRADED: optional AI services failed to start; application readiness passed. Retry ./bin/dev up after repair.')
        subprocess.run([*context, 'exec', '-T', 'app', './bin/dev', 'knowledge-status'], cwd=ROOT, check=False)
    return result.returncode


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print(f'Error: {error}', file=sys.stderr)
        sys.exit(1)
