#!/usr/bin/env python3
"""Host-side development lifecycle and resource profiles."""
import json
import os
from pathlib import Path
import re
import secrets
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
LOCAL = ROOT / '.env.dev.local'
OVERRIDE = ROOT / '.devcontainer/compose.resources.yaml'
PRESETS = {
    'low': ('2', '2G', '2', '1'),
    'standard': ('4', '4G', '4', '2'),
    'high': ('20', '16G', '12', '4'),
}
KEYS = ('DEV_CPU_LIMIT', 'DEV_MEMORY_LIMIT', 'TEST_WORKERS', 'PLAYWRIGHT_WORKERS')
ALLOWED = set(KEYS) | {'DEV_PROFILE', 'RUNA_UID', 'RUNA_GID'}


def load():
    values = dict(zip(KEYS, PRESETS['standard']))
    values.update(DEV_PROFILE='standard', RUNA_UID=str(os.getuid()), RUNA_GID=str(os.getgid()))
    if LOCAL.exists():
        for line in LOCAL.read_text().splitlines():
            if not line.strip() or line.lstrip().startswith('#'):
                continue
            key, sep, value = line.partition('=')
            if not sep or key not in ALLOWED:
                raise ValueError(f'Unsupported local profile setting: {key}')
            values[key] = value
    validate(values)
    return values


def validate(values):
    if values['DEV_PROFILE'] not in (*PRESETS, 'custom'):
        raise ValueError('DEV_PROFILE must be low, standard, high or custom.')
    if not re.fullmatch(r'[0-9]+(?:\.[0-9]+)?', values['DEV_CPU_LIMIT']) or float(values['DEV_CPU_LIMIT']) <= 0:
        raise ValueError('DEV_CPU_LIMIT must be a positive number.')
    if not re.fullmatch(r'[1-9][0-9]*(?:M|G)', values['DEV_MEMORY_LIMIT']):
        raise ValueError('DEV_MEMORY_LIMIT must be a positive integer followed by M or G.')
    for key in ('TEST_WORKERS', 'PLAYWRIGHT_WORKERS', 'RUNA_UID', 'RUNA_GID'):
        if not values[key].isdigit() or int(values[key]) < 1:
            raise ValueError(f'{key} must be a positive integer.')


def persist(values):
    validate(values)
    LOCAL.write_text(''.join(f'{key}={values[key]}\n' for key in ('DEV_PROFILE', *KEYS, 'RUNA_UID', 'RUNA_GID')))
    LOCAL.chmod(0o600)
    # VS Code invokes Compose itself, so it needs the same resolved settings.
    service = {'cpus': float(values['DEV_CPU_LIMIT']), 'mem_limit': values['DEV_MEMORY_LIMIT'],
               'build': {'args': {key: values[key] for key in ('RUNA_UID', 'RUNA_GID')}},
               'environment': {key: values[key] for key in ('TEST_WORKERS', 'PLAYWRIGHT_WORKERS')}}
    OVERRIDE.write_text(json.dumps({'services': {'app': service}}, indent=2) + '\n')


def main():
    args = sys.argv[1:]
    if not args or args[0] in ('--help', '-h'):
        print('Usage: ./bin/dev profile [low|standard|high|custom KEY=VALUE ...]\n'
              '       ./bin/dev prepare|setup|build|up|down|config|shell\n'
              'Run Docker lifecycle commands on the host. Profile changes apply on container recreation.\n'
              'down preserves volumes; destructive volume deletion is not supported.')
        return 0
    values = load()
    command = args.pop(0)
    if command == 'profile':
        if args:
            profile = args.pop(0)
            if profile not in (*PRESETS, 'custom'):
                raise ValueError('Unknown resource profile.')
            values['DEV_PROFILE'] = profile
            if profile != 'custom':
                if args:
                    raise ValueError('Overrides require the custom profile.')
                values.update(zip(KEYS, PRESETS[profile]))
            for setting in args:
                key, sep, value = setting.partition('=')
                if not sep or key not in KEYS:
                    raise ValueError('Custom settings must use the documented resource keys.')
                values[key] = value
            persist(values)
        print('\n'.join(f'{key}={values[key]}' for key in ('DEV_PROFILE', *KEYS)))
        return 0
    if command == 'setup':
        if args or not Path('/.dockerenv').exists():
            raise ValueError('Run ./bin/dev setup inside the devcontainer, without arguments.')
        env = ROOT / '.env'
        if not env.exists():
            env.write_text((ROOT / '.env.dev.example').read_text().replace(
                'DB_PASSWORD=\n', 'DB_PASSWORD=' + secrets.token_urlsafe(32) + '\n'))
            env.chmod(0o600)
        subprocess.run(['composer', 'install', '--no-interaction', '--prefer-dist'], cwd=ROOT, check=True)
        if any(line == 'APP_KEY=' for line in env.read_text().splitlines()):
            subprocess.run(['php', 'artisan', 'key:generate', '--force'], cwd=ROOT, check=True)
        subprocess.run(['php', 'artisan', 'runa:config:validate', '--templates'], cwd=ROOT, check=True)
        subprocess.run(['git', 'config', 'core.hooksPath', '.githooks'], cwd=ROOT, check=True)
        return 0
    if args:
        raise ValueError('Unexpected arguments. See ./bin/dev --help.')
    persist(values)
    if command == 'prepare':
        print('Development profile prepared; persistent data preserved.')
        return 0
    if Path('/.dockerenv').exists():
        raise ValueError('Run Docker lifecycle commands in a host terminal, outside the devcontainer.')
    commands = {'build': ['build', 'app'], 'up': ['up', '-d', '--wait'],
                'down': ['down'], 'config': ['config'], 'shell': ['exec', 'app', 'bash']}
    if command not in commands:
        raise ValueError('Unknown command. See ./bin/dev --help.')
    result = subprocess.run(['docker', 'compose', '--project-directory', str(ROOT),
                             '--env-file', str(LOCAL), '-f', str(ROOT / 'compose.yaml'),
                             '-f', str(OVERRIDE), *commands[command]], cwd=ROOT, check=False)
    return result.returncode


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print(f'Error: {error}', file=sys.stderr)
        sys.exit(1)
