#!/usr/bin/env python3
"""Toggle development CLI/FPM debugging without changing application settings."""
import os
from pathlib import Path
import re
import signal
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'tools/project'))
from runtime import app_command
args = sys.argv[1:]
if args == ['--help']:
    print('Usage: ./bin/xdebug on|off|status\nDevelopment-only CLI/FPM debug mode; off by default.')
    sys.exit(0)
if args not in (['on'], ['off'], ['status']):
    sys.exit('Usage: ./bin/xdebug on|off|status')
if not Path('/.dockerenv').exists():
    sys.exit(subprocess.call(app_command(['./bin/xdebug', *args]), cwd=ROOT))
config = Path('/usr/local/etc/php/conf.d/zz-runa-xdebug.ini')
if not config.exists():
    sys.exit('Xdebug is available only in the development image. Rebuild the devcontainer.')
if args[0] != 'status':
    mode = 'debug' if args[0] == 'on' else 'off'
    config.write_text(re.sub(r'^xdebug.mode = .*$', 'xdebug.mode = ' + mode,
                             config.read_text(), flags=re.MULTILINE))
    for process in Path('/proc').glob('[0-9]*/cmdline'):
        try:
            if process.read_bytes().startswith(b'php-fpm: master process'):
                os.kill(int(process.parent.name), signal.SIGUSR2)
        except ProcessLookupError:
            pass
subprocess.run(['php', '-r', 'echo "Xdebug ".phpversion("xdebug")." mode=".(ini_get("xdebug.mode") ?: "off").PHP_EOL;'], check=True)
