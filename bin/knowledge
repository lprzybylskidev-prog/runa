#!/usr/bin/env python3
"""Development-only project knowledge CLI."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'tools/knowledge'))


def main():
    parser = argparse.ArgumentParser(description='Development-only knowledge indexing and hybrid retrieval.')
    parser.add_argument('command', choices=['search', 'index', 'status', 'rebuild', 'stale', 'doctor', 'eval', 'initialize'])
    parser.add_argument('--device', choices=['auto', 'cpu'], default=None, help='Prefer CUDA when reachable, or force CPU for fallback acceptance.')
    parser.add_argument('query', nargs='?')
    parser.add_argument('--top-k', type=int, default=5)
    parser.add_argument('--explain', action='store_true')
    for field in ('document_type', 'scope', 'roadmap_id', 'status', 'source_path'):
        parser.add_argument('--' + field.replace('_', '-'))
    args = parser.parse_args()
    if args.command == 'search' and not args.query:
        parser.error('search requires a query')
    if os.environ.get('APP_ENV') == 'production' or not (ROOT / 'artisan').exists():
        raise ValueError('Knowledge CLI is unavailable in production.')
    if not Path('/.dockerenv').exists():
        return subprocess.run(['docker', 'compose', '--project-directory', str(ROOT), '--env-file', str(ROOT / '.env.dev.local'),
                               '-f', str(ROOT / 'compose.yaml'), '-f', str(ROOT / '.devcontainer/compose.resources.yaml'),
                               'exec', '-T', 'app', './bin/knowledge', *sys.argv[1:]], cwd=ROOT).returncode
    # Also inspect Laravel's actual local environment, rather than trusting the caller's default.
    environment = ROOT / '.env'
    if not environment.exists() or 'APP_ENV=local' not in environment.read_text().splitlines():
        raise ValueError('Knowledge CLI requires the local development environment.')
    from ingest import index, status
    config = json.loads((ROOT / 'tools/knowledge/config.json').read_text())
    lock_dir = ROOT / '.runtime/knowledge'
    lock_dir.mkdir(parents=True, exist_ok=True)
    with (lock_dir / 'index.lock').open('w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise ValueError('Knowledge indexing is running; retry after completion.') from error
        local = ROOT / '.env.dev.local'
        cuda = local.exists() and 'EMBEDDINGS_CUDA=1' in local.read_text().splitlines()
        device = args.device or ('auto' if cuda else 'cpu')
        if args.command == 'rebuild':
            from ingest import rebuild
            return rebuild(ROOT, config, device)
        if args.command in ('search', 'doctor', 'eval'):
            from retrieval import FILTERS, Retriever, doctor, evaluate
            if args.command == 'doctor':
                health = status(ROOT, config)
                if health['stale']:
                    print(json.dumps({**health, 'passed': False, 'instruction': 'Run ./bin/knowledge index; review model/schema mismatch before rebuild.'}, indent=2))
                    return 1
            retriever = Retriever(ROOT, config, device)
            if args.command == 'search':
                filters = {key: getattr(args, key) for key in FILTERS if getattr(args, key) is not None}
                hits = retriever.search(args.query, args.top_k, filters)
                if args.explain:
                    print(json.dumps({'filters': filters, 'retrieval': config['retrieval'], 'results': hits}, indent=2))
                else:
                    for rank, hit in enumerate(hits, 1):
                        p = hit['payload']
                        print(f"{rank}. {p['source_path']} — {p['section']}\n{p['content'][:420]}\n")
                    print('Open original source files before acting on retrieved rules.')
                return 0
            result = doctor(retriever) if args.command == 'doctor' else evaluate(
                retriever, json.loads((ROOT / 'tools/knowledge/golden.json').read_text()))
            print(json.dumps(result, indent=2))
            return 0 if result['passed'] else 1
        if args.command == 'initialize':
            from store import Store
            store = Store(config)
            # The shared CLI lock serializes existence checks and first writes.
            # An empty collection without a manifest can follow interrupted first setup.
            if not store.exists() or (not store.manifest() and not store.all_points()):
                return index(ROOT, config, device)
            result = status(ROOT, config, store)
            print(json.dumps(result, indent=2))
            if result['stale']:
                print('Existing knowledge index requires attention; run ./bin/knowledge index explicitly.')
            return 0
        if args.command == 'index':
            return index(ROOT, config, device)
        result = status(ROOT, config)
        print(json.dumps(result, indent=2))
        if result['stale']:
            print('Run ./bin/knowledge index before relying on knowledge results.', file=sys.stderr)
        return 1 if result['stale'] else 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (ValueError, OSError, RuntimeError, subprocess.CalledProcessError) as error:
        print(f'Error: {error}', file=sys.stderr)
        sys.exit(1)
