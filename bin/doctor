#!/usr/bin/env python3
"""Quick global and focused deterministic project diagnostics."""
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'tools/project'))
from runtime import app_command, host_stack_health, inside, run
import checks

AREAS = ('repository', 'config', 'maintenance', 'hooks', 'frontend', 'database-migrations', 'database', 'seeding', 'boost', 'tooling', 'docs', 'release', 'cleanliness', 'development', 'production')
try:
    args = sys.argv[1:]
    if args == ['--help']:
        print('Usage: ./bin/doctor [area]\nNo area: quick whole-development diagnostic. Focused areas: ' + ', '.join(AREAS) + '.\nChecks never repair or deploy. Database-migrations resets only the guarded testing database.')
    elif args == ['production']:
        run([str(ROOT / 'bin/production'), 'self-test'])
    elif not inside():
        if not args or args == ['development']:
            host_stack_health()
        raise SystemExit(subprocess.run(app_command(['./bin/doctor', *args]), cwd=ROOT).returncode)
    else:
        if len(args) > 1 or (args and args[0] not in AREAS):
            raise ValueError('Unknown doctor area. See ./bin/doctor --help.')
        area = args[0] if args else 'global'
        if area == 'global':
            checks.repository(); checks.maintenance(); checks.docs(); checks.tooling(); checks.development()
        elif hasattr(checks, area):
            getattr(checks, area)()
        else:
            commands = {
                'config': ['php', 'artisan', 'runa:config:validate', '--templates'],
                'hooks': ['python3', 'tools/testing/hooks.py'],
                'frontend': ['node', 'tools/testing/frontend.mjs'],
                'database-migrations': ['python3', 'tools/testing/database-guards.py'],
                'database': ['./bin/test', '--filter=Database'],
                'seeding': ['./bin/test', '--filter=Seeding'],
            }
            if area == 'release':
                checks.repository()
                raise ValueError('Full release metadata validation awaits release tooling in RM-2026-001; no release PASS claimed.')
            run(commands[area])
except (ValueError, OSError, KeyError, TypeError, subprocess.CalledProcessError) as error:
    print(f'Doctor failed: {error}', file=sys.stderr)
    sys.exit(getattr(error, 'returncode', 1))
