#!/usr/bin/env python3
"""Stable source transport; resolve aliases before selecting the fixed package adapter."""

import os
import subprocess
import sys
from pathlib import Path

if __name__ == "__main__":
    root = Path(__file__).resolve().parents[1]
    raise SystemExit(
        subprocess.call(
            [sys.executable, "-m", "tools.application.artisan_cli", *sys.argv[1:]],
            cwd=root,
            env=dict(os.environ, PYTHONPYCACHEPREFIX=str(root / ".runtime/python/pycache")),
        )
    )
