#!/usr/bin/env python3
"""Fixed owner hook composition transport."""

import os
import subprocess
import sys
from pathlib import Path

if __name__ == "__main__":
    root = Path(__file__).resolve().parents[2]
    repository = subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip()
    env = dict(os.environ, PYTHONPYCACHEPREFIX=str(root / ".runtime/python/pycache"))
    if env.get("GIT_INDEX_FILE"):
        env["GIT_INDEX_FILE"] = str(Path(env["GIT_INDEX_FILE"]).absolute())
    raise SystemExit(
        subprocess.call(
            [sys.executable, "-m", "tools.maintainer.hook_cli", repository, *sys.argv[1:]],
            cwd=root,
            env=env,
        )
    )
