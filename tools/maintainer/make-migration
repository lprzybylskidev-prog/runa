    raise SystemExit(
        subprocess.call(
            [sys.executable, "-m", "tools.maintainer.migration_cli", *sys.argv[1:]],
            cwd=root,
            env=dict(os.environ, PYTHONPYCACHEPREFIX=str(root / ".runtime/python/pycache")),
        )
    )
