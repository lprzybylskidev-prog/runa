#!/usr/bin/env python3
"""Fixed-purpose owner entrypoints, selected only by their versioned filename."""
import sys
from pathlib import Path
from context import ROOT, container

name = Path(sys.argv[0]).name
arguments = sys.argv[1:]
CHECKS = {'check-repository': 'repository', 'check-maintenance': 'maintenance', 'check-docs': 'docs', 'check-release': 'release', 'check-cleanliness': 'cleanliness', 'check-tooling': 'tooling', 'check-development': 'development', 'check-frontend': 'frontend', 'check-database-migrations': 'database-migrations'}
QUALITY = {'quality-plan': 'show', 'quality-roadmap': 'roadmap', 'quality-final': 'final', 'quality-status': 'status'}
TESTS = {'test-backend': 'backend', 'test-frontend': 'frontend', 'test-e2e': 'e2e'}
if arguments == ['--help']:
    print('Usage: python3 tools/maintainer/' + name + (' [--background]' if name in ('quality-roadmap', 'quality-final') else ' [runner options]' if name in TESTS else ''))
    raise SystemExit(0)
if name in CHECKS:
    if arguments:
        raise SystemExit('This diagnostic takes no arguments.')
    container(Path(sys.argv[0]).absolute(), arguments)
    import checks
    area = CHECKS[name]
    if area in ('frontend', 'database-migrations'):
        from runtime import run
        run(['node', 'src/runa/tools/testing/frontend.mjs'] if area == 'frontend' else ['python3', 'tools/maintainer/testing/database-guards.py'])
    else:
        getattr(checks, area)()
elif name in QUALITY:
    if arguments not in ([], ['--background']) or (arguments and name in ('quality-plan', 'quality-status')):
        raise SystemExit('Only quality-roadmap/final accept --background.')
    import runpy
    import quality
    quality.RUN_DIRECTORY = ROOT / '.runtime/quality'
    quality.COMMAND_PREFIX = 'python3 tools/maintainer/quality-'
    original_plan = quality.plan
    quality.plan = lambda final=False: original_plan(final, ROOT / 'docs/roadmaps/active', ROOT / 'docs/quality/gates.yml')
    sys.argv = [sys.argv[0], QUALITY[name], *arguments]
    runpy.run_path(str(ROOT / 'tools/application/executors/quality.py'), run_name='__main__')
elif name in TESTS:
    container(Path(sys.argv[0]).absolute(), arguments)
    from owner_tests import execute
    raise SystemExit(execute(TESTS[name], arguments))
else:
    raise SystemExit('Invoke a named owner entrypoint; this module has no public actions.')
