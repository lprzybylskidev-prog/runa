#!/usr/bin/env python3
"""Fixed private source adapter; preserve the alias before choosing its package entry."""

import os
import subprocess
import sys
from pathlib import Path

if __name__ == "__main__":
    root = Path(__file__).resolve().parents[2]
    raise SystemExit(
        subprocess.call(
            [
                sys.executable,
                "-m",
                "tools.maintainer.database_cli",
                Path(sys.argv[0]).name,
                *sys.argv[1:],
            ],
            cwd=root,
            env=dict(os.environ, PYTHONPYCACHEPREFIX=str(root / ".runtime/python/pycache")),
        )
    )
