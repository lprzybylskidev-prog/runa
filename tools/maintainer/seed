#!/usr/bin/env python3
"""Run one explicit Runa seeder; excluded from customer delivery."""
import subprocess
import sys
from pathlib import Path
from context import ROOT, container
container(Path(__file__).resolve(), sys.argv[1:])
args = sys.argv[1:]
if args == ['--help']:
    print('Run one explicit Runa seeder. Platform/application reset isolation is implemented in roadmap point 9c.')
    raise SystemExit(0)
if len(args) != 1 or not args[0].startswith('Runa\\Database\\Seeders\\'):
    raise SystemExit('Provide one explicit Runa\\Database\\Seeders\\ClassName.')
command = ['db:seed', '--class=' + args[0]]
raise SystemExit(subprocess.run(['php', 'artisan', *command], cwd=ROOT / 'src').returncode)
