#!/usr/bin/env python3
"""Runa owner diagnostics; no customer Artisan alias."""
import sys
from pathlib import Path
from context import ROOT, container
container(Path(__file__).resolve(), sys.argv[1:])
import checks
if sys.argv[1:] == ['--help']:
    print('Usage: python3 tools/maintainer/doctor repository|maintenance|docs|release|cleanliness|tooling|development|frontend|database-migrations')
elif len(sys.argv) == 2 and sys.argv[1] in ('repository', 'maintenance', 'docs', 'release', 'cleanliness', 'tooling', 'development'):
    getattr(checks, sys.argv[1])()
elif sys.argv[1:] in (['frontend'], ['database-migrations']):
    from runtime import run
    run(['node', 'src/runa/tools/testing/frontend.mjs'] if sys.argv[1] == 'frontend' else ['python3', 'tools/maintainer/testing/database-guards.py'])
else:
    raise SystemExit('Select a supported Runa diagnostic area; see --help.')
