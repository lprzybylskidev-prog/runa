#!/usr/bin/env python3
"""Runa platform test entrypoint, excluded from customer delivery."""
import sys
import os
import fcntl
from pathlib import Path
from context import ROOT, container
container(Path(__file__).resolve(), sys.argv[1:])
import subprocess
args = sys.argv[1:]
if args == ['--help']:
    print('Usage: python3 tools/maintainer/test [backend Pest options | frontend Vitest options | e2e Playwright options]')
    raise SystemExit(0)
if args[:1] == ['frontend']:
    command = ['pnpm', 'exec', 'vitest', 'run', 'runa/tests/frontend', *args[1:]]
elif args[:1] == ['e2e']:
    command = ['pnpm', 'exec', 'playwright', 'test', *[a for a in args[1:] if a != '--critical']]
else:
    if '--parallel' in args and not any(a.startswith('--processes') for a in args):
        args.append('--processes=' + os.environ.get('TEST_WORKERS', '4'))
    command = ['vendor/bin/pest', 'runa/tests', *args]
directory = ROOT / '.runtime/tests'
directory.mkdir(parents=True, exist_ok=True)
with (directory / 'suite.lock').open('a') as lock:
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise SystemExit('Another test suite is running in this checkout.')
    raise SystemExit(subprocess.run(command, cwd=ROOT / 'src', env=dict(os.environ, APP_ENV='testing')).returncode)
