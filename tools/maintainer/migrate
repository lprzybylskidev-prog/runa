#!/usr/bin/env python3
"""Run only Runa migrations; excluded from customer delivery."""
import subprocess
import sys
from pathlib import Path
from context import ROOT, container
container(Path(__file__).resolve(), sys.argv[1:])
args = sys.argv[1:]
if args == ['--help']:
    print('Run only Runa migrations. Platform/application reset isolation is implemented in roadmap point 9c.')
    raise SystemExit(0)
if any(a.startswith(('--path', '--database', '--realpath')) for a in args):
    raise SystemExit('Platform scope cannot be overridden.')
command = ['migrate', '--path=runa/database/migrations', *args]
raise SystemExit(subprocess.run(['php', 'artisan', *command], cwd=ROOT / 'src').returncode)
