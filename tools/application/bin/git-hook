#!/usr/bin/env python3
"""Select a fixed hook alias and retain its requested repository."""

import os
from pathlib import Path
import subprocess
import sys

if __name__ == "__main__":
    root = Path(__file__).resolve().parents[3]
    hook = Path(sys.argv[0]).name
    if hook not in ("pre-commit", "commit-msg"):
        raise SystemExit("Invoke the dedicated pre-commit or commit-msg launcher.")
    if sys.argv[1:] == ["--help"]:
        print(
            "Usage: tools/application/bin/"
            + hook
            + (" <message-file>" if hook == "commit-msg" else "")
        )
        raise SystemExit(0)
    repository = subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip()
    environment = dict(os.environ, PYTHONPYCACHEPREFIX=str(root / ".runtime/python/pycache"))
    if environment.get("GIT_INDEX_FILE"):
        environment["GIT_INDEX_FILE"] = str(Path(environment["GIT_INDEX_FILE"]).absolute())
    raise SystemExit(
        subprocess.call(
            [sys.executable, "-m", "tools.application.hook_cli", repository, hook, *sys.argv[1:]],
            cwd=root,
            env=environment,
        )
    )
