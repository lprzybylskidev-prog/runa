{
  "collection": "runa_knowledge",
  "schema_version": 1,
  "model_id": "BAAI/bge-small-en-v1.5",
  "model_revision": "5c38ec7c405ec4b44b94cc5a9bb96e735b38267a",
  "runtime_version": "1.9.4",
  "dimension": 384,
  "max_input_tokens": 512,
  "chunk_tokens": 420,
  "batch_size": 16,
  "query_prefix": "Represent this sentence for searching relevant passages: ",
  "qdrant_url": "http://qdrant:6333",
  "cpu_url": "http://embeddings:8080",
  "cuda_url": "http://embeddings-gpu:8080",
  "files": [
    "AGENTS.md",
    "README.md",
    "docs/README.md",
    "tools/application/quality.yml"
  ],
  "markdown_roots": ["docs/app", "docs/runa/handbook", ".agents/skills"],
  "pooling": "cls",
  "dtype": "float32",
  "normalize": true,
  "retrieval": {
    "candidates": 60,
    "dense_weight": 2.0,
    "lexical_weight": 1.0,
    "rrf_k": 60,
    "per_source": 1,
    "active_boost": 1.03,
    "historical_weight": 0.8
  },
  "payload_schema_version": 2,
  "metadata_rules": [
    {
      "pattern": "AGENTS.md",
      "purpose": "current_guidance"
    },
    {
      "pattern": "README.md",
      "purpose": "current_guidance"
    },
    {
      "pattern": "docs/README.md",
      "purpose": "current_guidance"
    },
    {
      "pattern": ".agents/skills/*",
      "purpose": "current_guidance"
    },
    {
      "pattern": "docs/runa/handbook/*",
      "purpose": "current_guidance"
    }
  ]
}
