{
  "name": "runa",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.22.0",
    "pnpm": "12.14.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build && pnpm run build:errors",
    "build:errors": "vite build --config vite.errors.config.mjs && node .runtime/error-renderer/render.mjs",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/browser-playwright": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.3.0",
    "vue-tsc": "3.3.13"
  }
}
