<?php
namespace MODULE_NAMESPACE\Definitions;
final class Integrations implements \Runa\Contracts\Modules\IntegrationProvider
{
    public function integrations(): array { return [new \Runa\Contracts\Modules\IntegrationDefinition('audit', 'PUBLISHER_ID', \Tests\Fixtures\EventCalls::$integrationEnabled, ['pl' => 'Audyt', 'en' => 'Audit'], \Tests\Fixtures\EventCalls::$integrationConfig)]; }
    public function validConfiguration(string $key, array $config): bool { return array_keys($config) === ['format'] && in_array($config['format'], ['compact', 'full'], true); }
}
