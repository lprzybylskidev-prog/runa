<?php

namespace App\Management\FIXTURE_NAMESPACE;

use Runa\Contracts\Modules\ManagementResourceReader;
use Runa\Contracts\Modules\ManagementOptionsReader;
use Runa\Contracts\Modules\ManagementWidgetReader;
use Runa\Contracts\Modules\ManagementWriter;
use Runa\Contracts\Modules\ManagementOptionsRead;
use Runa\Contracts\Modules\ManagementWidgetResult;
use Runa\Contracts\Modules\ManagementRead;
use Runa\Contracts\Modules\ManagementRecord;
use Runa\Contracts\Modules\ManagementPageResult;
use Runa\Contracts\Modules\ManagementOptions;
use Runa\Contracts\Modules\ManagementWrite;
use Runa\Contracts\Modules\ManagementReview;
use Runa\Contracts\Modules\ManagementOutcome;
use Runa\Support\Modules\Api\OperationRejected;

final class Handler implements ManagementResourceReader, ManagementOptionsReader, ManagementWidgetReader, ManagementWriter
{
    public static int $calls = 0;
    public static bool $rawSecret = false;
    public static bool $changed = false;
    public static bool $failure = false;
    public static ?string $optionField = null;
    public static ?string $observedAt = null;
    public static ?string $expiresAt = null;
    public function read(ManagementRead $input): ManagementRecord
    {
        self::$calls++;
        if (self::$changed) { \Illuminate\Support\Facades\DB::table('shared.module_registry_state')->where('id', 1)->increment('generation'); }
        if (self::$failure) { throw new \RuntimeException('private-exception-marker'); }
        return new ManagementRecord($input->publicId, 'revision-1', ['name' => 'Visible', 'hidden' => 'private-value-marker', 'unlisted' => 'unlisted-marker', 'token' => self::$rawSecret ? 'private-secret-marker' : ['set' => true]]);
    }
    public function page(ManagementRead $input): ManagementPageResult { return new ManagementPageResult([$this->read($input)], null); }
    public function options(ManagementOptionsRead $input): ManagementOptions { self::$calls++; return new ManagementOptions(self::$optionField ?? $input->field, [['value' => 'private-option', 'label' => 'Private option']], null); }
    public function widget(ManagementRead $input): ManagementWidgetResult
    {
        if (self::$failure) { throw new \RuntimeException('private-exception-marker'); }
        return new ManagementWidgetResult(['count' => 3], self::$observedAt, self::$expiresAt);
    }
    public function preview(ManagementWrite $input): ManagementReview { throw new OperationRejected('admin_operation_unavailable', 'runa.admin', 'preview', 404); }
    public function execute(ManagementWrite $input): ManagementOutcome { throw new OperationRejected('admin_operation_unavailable', 'runa.admin', 'command', 404); }
}
