# Exact annotated release version (vX.Y.Z) or full lowercase Git commit hash.
RUNA_IMAGE_TAG=
# Loopback listener for the host TLS reverse proxy; development uses port 8080.
RUNA_HTTP_PORT=8081
# Use simulation for local acceptance with separate containers and volumes.
RUNA_PRODUCTION_MODE=real
# Unified install sets builtin and generates a private overlay, or explicitly verifies external TLS.
RUNA_TLS_MODE=external
