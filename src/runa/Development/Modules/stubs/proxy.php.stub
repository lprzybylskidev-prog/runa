namespace {{namespace}}\Proxies;

use {{namespace}}\Contracts\{{name}};
use Runa\Support\Modules\Api\GuardedApi;

final class {{name}}Proxy extends GuardedApi implements {{name}}
{
    public function read(): string
    {
        $result = $this->invoke('read', []);
