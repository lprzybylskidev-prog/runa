{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "runa/application",
  "type": "project",
  "description": "Runa application",
  "require": {
    "php": "^8.4",
    "laravel/framework": "13.37.0"
  },
  "require-dev": {
    "larastan/larastan": "3.13.0",
    "laravel/boost": "2.10.3",
    "laravel/pint": "1.32.1",
    "pestphp/pest": "5.3.2",
    "pestphp/pest-plugin-laravel": "5.0.1",
    "phpstan/phpstan": "2.3.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Runa\\": "runa/",
      "Runa\\Database\\Seeders\\": "runa/database/seeders/",
      "Runa\\Database\\Factories\\": "runa/database/factories/",
      "Database\\Seeders\\": "app/database/seeders/",
      "Database\\Factories\\": "app/database/factories/"
    },
    "exclude-from-classmap": [
      "runa/management/",
      "runa/Testing/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "runa/Testing/",
      "ApplicationTests\\": "app/tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
