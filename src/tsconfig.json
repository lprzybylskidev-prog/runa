{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "paths": {
      "@/runa/*": ["./runa/resources/js/runa/*"],
      "@/runa/ui": ["./runa/resources/js/runa/ui/index.ts"],
      "@runa/*": ["./runa/resources/js/*"],
      "@/*": ["./app/resources/js/*"],
      "@runa/testing/playwright": ["./runa/Testing/playwright.ts"],
      "vitest": ["./node_modules/vitest"],
      "@vue/test-utils": ["./node_modules/@vue/test-utils"],
      "vue": ["./node_modules/vue"],
      "@runa/testing/vue": ["./runa/Testing/vue.ts"],
      "@runa/testing/vitest": ["./runa/Testing/vitest.ts"]
    },
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client"],
    "skipLibCheck": true
  },
  "include": [
    "app/resources/**/*.ts",
    "app/modules/**/*.ts",
    "app/modules/**/*.vue",
    "runa/modules/**/*.ts",
    "runa/modules/**/*.vue",
    "app/resources/**/*.vue",
    "runa/resources/**/*.ts",
    "runa/resources/**/*.vue",
    "../tests/frontend/runa/unit/**/*.ts",
    "../tests/frontend/runa/e2e/**/*.ts",
    "../tests/frontend/app/unit/**/*.ts",
    "../tests/frontend/app/e2e/**/*.ts"
  ]
}
