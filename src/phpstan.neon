includes:
    - vendor/larastan/larastan/extension.neon
parameters:
    level: max
    paths:
        - artisan
        - app
        - runa/Console
        - runa/Contracts
        - runa/Configuration
        - runa/Identity
        - runa/Integration
        - runa/Logging
        - runa/Mail
        - runa/ModuleFramework
        - runa/modules
        - runa/Runtime
        - runa/Database
        - runa/Development
        - runa/Foundation
        - runa/Http
        - runa/Providers
        - runa/Support
        - runa/Testing
        - runa/Tooling/Management
        - bootstrap/app.php
        - runa/config
        - runa/database
        - runa/routes
    tmpDir: ../.runtime/phpstan
    parallel:
        maximumNumberOfProcesses: 1
