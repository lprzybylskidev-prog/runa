#!/usr/bin/env php
<?php

use Illuminate\Console\Command;
use Illuminate\Foundation\Application;
use Symfony\Component\Console\Input\ArgvInput;
use Symfony\Component\Console\Output\ConsoleOutput;

define('LARAVEL_START', microtime(true));

// Register the Composer autoloader...
require is_file(__DIR__.'/vendor/autoload.php') ? __DIR__.'/vendor/autoload.php' : dirname(__DIR__).'/vendor/autoload.php';

/** @var list<string> $arguments */
$arguments = $_SERVER['argv'];
$management = ($arguments[1] ?? null) === '--management';
if ($management) {
    array_splice($arguments, 1, 1);
}
$input = new ArgvInput($arguments);
$registry = __DIR__.'/runa/management/commands.php';
if (is_file($registry)) {
    /** @var list<class-string<Command>> $commands */
    $commands = require $registry;
    $names = array_map(static fn (string $class): ?string => (new $class)->getName(), $commands);
    if ($management || in_array($input->getFirstArgument(), $names, true)) {
        /** @var Illuminate\Console\Application $console */
        $console = require __DIR__.'/runa/management/bootstrap.php';
        exit($console->run($input, new ConsoleOutput));
    }
} elseif ($management) {
    fwrite(STDERR, "Management tooling is unavailable in this application image.\n");
    exit(1);
}

// Bootstrap Laravel and handle the command...
/** @var Application $app */
$app = require_once __DIR__.'/bootstrap/app.php';

$status = $app->handleCommand($input);

exit($status);
