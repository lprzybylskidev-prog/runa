includes:
    - vendor/larastan/larastan/extension.neon
parameters:
    level: max
    paths:
        - artisan
        - src/artisan
        - src/app
        - src/runa/src
        - src/runa/management
        - src/bootstrap/app.php
        - src/runa/config
        - src/runa/database
        - src/runa/routes
    tmpDir: .runtime/phpstan
    parallel:
        maximumNumberOfProcesses: 1
